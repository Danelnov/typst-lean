import Lean

/-!
# External call to the Typst compiler

Lean does not include Typst, so we invoke it as an external process
(`IO.Process.output`). We write the document to a temporary file, run
`typst compile --format svg <input> <output>`, and read the resulting SVG.
-/

namespace Typst

/-- Minimal configuration for a compilation. -/
structure Config where
  /-- Explicit path to the executable (empty = resolve automatically). -/
  bin : String := ""
  /-- Typst code prepended to every document. -/
  preamble : String := ""
  /-- `"math"` wraps the body in `$ ... $`; any other value leaves it unchanged. -/
  mode : String := "math"

/-- Internal preamble: a page that fits the content, with a transparent background.
The font size is set here; users can override it in their preamble. -/
def internalPrelude : String :=
  "#set page(width: auto, height: auto, margin: 6pt, fill: none)\n" ++
  "#set text(size: 14pt)\n"

/-- Resolution order: `typst.bin` option → `TYPST_BIN` environment variable → `typst` on PATH. -/
def resolveBin (explicit : String) : IO String := do
  if !explicit.isEmpty then return explicit
  match ← IO.getEnv "TYPST_BIN" with
  | some p => return (if p.isEmpty then "typst" else p)
  | none   => return "typst"

/-- A complete Typst document from the body generated by `ToTypst`. -/
def assemble (cfg : Config) (body : String) : String :=
  let body := if cfg.mode == "math" then "$ " ++ body ++ " $" else body
  internalPrelude ++ cfg.preamble ++ "\n" ++ body ++ "\n"

/-- Help message shown when the executable cannot be launched. -/
def missingBinMsg (bin detail : String) : String :=
  s!"No se pudo ejecutar '{bin}': {detail}\n" ++
  "Instala Typst o indica su ruta con `set_option typst.bin \"/ruta/a/typst\"` " ++
  "(o con la variable de entorno TYPST_BIN, definida antes de abrir el editor)."

/-- Compiles `source` to SVG. Returns `.error` with Typst's message (stderr) on failure. -/
def compileSvg (cfg : Config) (source : String) : IO (Except String String) := do
  let bin ← resolveBin cfg.bin
  let (h, inPath) ← IO.FS.createTempFile
  let outPath : System.FilePath := inPath.toString ++ ".svg"
  try
    h.putStr source
    h.flush
    let out ← IO.Process.output {
      cmd := bin
      args := #["compile", "--format", "svg", inPath.toString, outPath.toString]
    }
    if out.exitCode != 0 then
      let err := out.stderr.trim
      -- If the executable does not exist, Lean reports it as a child-process failure (not an exception).
      if (err.splitOn "could not execute external process").length > 1 then
        return .error (missingBinMsg bin err)
      return .error (if err.isEmpty then s!"typst terminó con código {out.exitCode}" else err)
    return .ok (← IO.FS.readFile outPath)
  catch e =>
    -- Typically, the executable does not exist or is not on Lean's process PATH.
    return .error (missingBinMsg bin (toString e))
  finally
    try IO.FS.removeFile inPath catch _ => pure ()
    try IO.FS.removeFile outPath catch _ => pure ()

end Typst
